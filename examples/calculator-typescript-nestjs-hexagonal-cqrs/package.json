{
  "name": "calculator-typescript-nestjs-hexagonal-cqrs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "lint": "oxlint --type-aware src test && depcruise src --config .dependency-cruiser.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "dependency-cruiser": "^18.9.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "supertest": "^7.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
